@baseUrl = http://localhost:3000

### 1. Registro - 201
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{ "nombre": "Ana", "email": "ana@libreria.test", "password": "Libreria2026" }

### 2. Registro mismo email - 409
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{ "nombre": "Ana", "email": "ana@libreria.test", "password": "Libreria2026" }

### 3. Registro password corta - 400
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{ "nombre": "Ana", "email": "ana2@libreria.test", "password": "corta" }

### 4. Login mail inexistente - 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "noexiste@libreria.test", "password": "Libreria2026" }

### 5. Login password mal - 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "admin@libreria.test", "password": "wrongpassword" }

### 6. Login correcto - 200 con token
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "admin@libreria.test", "password": "Admin1234" }

### Token del login
@token = {{login.response.body.token}}

### 7. GET /auth/yo sin header - 401
GET {{baseUrl}}/api/auth/yo

### 8. GET /auth/yo con token ADMIN - 200
GET {{baseUrl}}/api/auth/yo
Authorization: Bearer {{token}}

### 9. POST /api/libros sin header - 401
POST {{baseUrl}}/api/libros
Content-Type: application/json

{ "titulo": "Nuevo", "precio": 1000, "imagen": "https://example.com/img.jpg", "autorId": 1 }

### Login como CLIENTE para casos 10
# @name loginCliente
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "cliente@libreria.test", "password": "Cliente1234" }

@tokenCliente = {{loginCliente.response.body.token}}

### 10. POST /api/libros con token CLIENTE - 403
POST {{baseUrl}}/api/libros
Content-Type: application/json
Authorization: Bearer {{tokenCliente}}

{ "titulo": "Nuevo", "precio": 1000, "imagen": "https://example.com/img.jpg", "autorId": 1 }

### 11. POST /api/libros con token ADMIN - 201
POST {{baseUrl}}/api/libros
Content-Type: application/json
Authorization: Bearer {{token}}

{ "titulo": "El tunel", "precio": 1890, "imagen": "https://covers.openlibrary.org/b/id/8739200-L.jpg", "autorId": 1 }

### 12. GET /api/libros sin header - 200 publico
GET {{baseUrl}}/api/libros
